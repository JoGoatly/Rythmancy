  m_Script: {fileID: 11500000, guid: 44a2b19809ed4254cbee74bd04c48ca6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 6031556089942846563}
  guideArrow: {fileID: 1836807166}
  guideArrowHeightOffset: 2
  guideArrowOrbitRadius: 1.5
  steps:
  - text: Willkommen in Rhythmancy
    advanceMode: 0
    unlocksMovement: 1
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Bewege dich mit WASD in die Markierte Zone
    advanceMode: 2
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 1402467585}
    targetAreaRadius: 1.5
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Sehr Gut
    advanceMode: 0
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal: []
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0.5
  - text: Probiere nun die Puppe zu treffen indem du U perfekt beim Beat triffst
    advanceMode: 3
    unlocksMovement: 0
    damageToApplyOnShow: 2
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 925600034195436190}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 5039138488286988605}
    thrownObjectSprite: {fileID: -302779026, guid: aef4a2c559fc05649afac4e9999b73f0, type: 3}
    thrownObjectDamage: 10
    thrownObjectFlightDuration: 0.5
  - text: "Der Gegner hat vor seinem Tot etwas nach dir geworfen und dir schaden
      gemacht, die Gr\xFCne Leiste zeigt dir an, wie viel Leben du hast. Ist diese
      Leiste leer, ist es vorbei."
    advanceMode: 0
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 3884049097479037335}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
  - text: "Zudem Hat der Gegner eine M\xFCnze fallen gelassen, du kannst jederzeit
      rechts oben die Anzahl deiner gesammelten M\xFCnzen sehen"
    advanceMode: 0
    unlocksMovement: 0
    damageToApplyOnShow: 0
    marker: {fileID: 0}
    uiElementsToReveal:
    - {fileID: 1777275164630608520}
    - {fileID: 7881773815320843706}
    targetArea: {fileID: 0}
    targetAreaRadius: 0
    enemyToDefeat: {fileID: 0}
    thrownObjectSprite: {fileID: 0}
    thrownObjectDamage: 0
    thrownObjectFlightDuration: 0
